<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PDFGeek.Smoke</RootNamespace>
    <AssemblyName>PDFGeek.Smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <!--
    Compiles the real PdfOps and PageRange straight out of the app rather than a copy, so this
    harness always exercises exactly the code that ships. FontSetup is excluded because it
    resolves Windows fonts; the harness registers its own resolver instead.
  -->
  <ItemGroup>
    <Compile Include="../../src/PDFGeek/Services/PdfOps.cs" Link="Services/PdfOps.cs" />
    <Compile Include="../../src/PDFGeek/Services/PageRange.cs" Link="Services/PageRange.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TechyGeeksHome.Common\TechyGeeksHome.Common.csproj" />
  </ItemGroup>

</Project>
